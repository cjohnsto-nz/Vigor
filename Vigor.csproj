<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(GameVersion)' == '1.21'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0-windows</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <GameVersion Condition="'$(GameVersion)' == '' and '$(VINTAGE_STORY_VERSION)' != ''">$(VINTAGE_STORY_VERSION)</GameVersion>
    <GamePath Condition="'$(GamePath)' == '' and '$(GameVersion)' == '1.21' and '$(VINTAGE_STORY_121)' != ''">$(VINTAGE_STORY_121)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and '$(GameVersion)' == '1.22' and '$(VINTAGE_STORY_122)' != ''">$(VINTAGE_STORY_122)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and Exists('$(VINTAGE_STORY)')">$(VINTAGE_STORY)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and Exists('C:\Users\$(USERNAME)\AppData\Roaming\Vintagestory')">C:\Users\$(USERNAME)\AppData\Roaming\Vintagestory</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\common\Vintage Story')">C:\Program Files (x86)\Steam\steamapps\common\Vintage Story</GamePath>
    <DefineConstants>$(DefineConstants);VINTAGE_STORY</DefineConstants>
    <AssemblyName>Vigor</AssemblyName>
    <RootNamespace>Vigor</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo> <!-- We'll use AssemblyInfo.cs -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI.dll">
      <HintPath>$(GamePath)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib.dll">
      <HintPath>$(GamePath)\VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony.dll">
      <HintPath>$(GamePath)\Lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net.dll">
      <HintPath>$(GamePath)\Lib\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <!-- Define the name of your mod's output folder -->
    <ModFolderName>Vigor</ModFolderName>
    <!-- Define where the packaged mod will be placed, relative to the project output path -->
    <ModPackageDir>ModPackage\$(ModFolderName)\</ModPackageDir>
    <PackagedGameDependencyVersion Condition="'$(GameVersion)' != ''">$(GameVersion).0</PackagedGameDependencyVersion>
    <PackagedGameDependencyVersion Condition="'$(PackagedGameDependencyVersion)' == ''">1.22.0</PackagedGameDependencyVersion>
    <PackagedGameVersionKey Condition="'$(GameVersion)' != ''">$([System.String]::Copy('$(GameVersion)').Replace('.', ''))</PackagedGameVersionKey>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Gui\**" />
    <Compile Remove="_decomp_vs_api\**\*.cs" />
    <Compile Remove="_decomp_vs_lib\**\*.cs" />
    <Compile Remove="_tmp_ilspy_survival\**\*.cs" />
    <Compile Remove="_tmp_ilspy_vs122_startup\**\*.cs" />
    <Compile Remove="_tmp_ilspy_windmill\**\*.cs" />
    <None Include="Gui\**" />
  </ItemGroup>

  <Target Name="PackageMod" AfterTargets="Build">
    <PropertyGroup>
      <!-- Full path to the packaged mod directory -->
      <FullModPackagePath>$(OutputPath)\$(ModPackageDir)</FullModPackagePath>
    </PropertyGroup>

    <Message Text="Packaging Vigor mod to: $(FullModPackagePath)" Importance="high" />

    <!-- Create the target directory -->
    <MakeDir Directories="$(FullModPackagePath)" />
    <MakeDir Directories="$(FullModPackagePath)assets" />

    <!-- Copy modinfo.json -->
    <Copy SourceFiles="modinfo.json" DestinationFolder="$(FullModPackagePath)" />

    <Message Text="Rewriting packaged modinfo.json game dependency to: $(PackagedGameDependencyVersion), game version key: $(PackagedGameVersionKey)" Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$modinfoPath = '$(FullModPackagePath)modinfo.json'; $modinfo = Get-Content -LiteralPath $modinfoPath -Raw | ConvertFrom-Json; if (-not $modinfo.dependencies) { $modinfo | Add-Member -NotePropertyName dependencies -NotePropertyValue (@{}) }; $modinfo.dependencies.game = '$(PackagedGameDependencyVersion)'; $v = [string]$modinfo.version; if ('$(PackagedGameVersionKey)' -ne '') { $parts = $v -split '\.'; $parts[0] = '$(PackagedGameVersionKey)'; $v = $parts -join '.' }; $modinfo.version = $v; $modinfo | ConvertTo-Json -Depth 10 | Set-Content -LiteralPath $modinfoPath -Encoding UTF8&quot;" />

    <!-- Copy the compiled DLL -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FullModPackagePath)" />

    <!-- Copy assets -->
    <!-- Ensure the assets folder exists in your project root -->
    <ItemGroup>
      <_ModAssets Include="assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ModAssets)" DestinationFiles="@(_ModAssets->'$(FullModPackagePath)assets\%(RecursiveDir)%(Filename)%(Extension)')" />

    <Message Text="Vigor mod packaged successfully." Importance="high" />
  </Target>
</Project>
